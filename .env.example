# Di server, .env disusun otomatis dari detektifsains-config.php (bootstrap/siapkan-env.php).
# Berkas ini hanya contoh untuk pengembangan lokal.
APP_NAME="Detektif Sains"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id

LOG_CHANNEL=daily
LOG_LEVEL=debug
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Tutor AI: anthropic | openai | gemini (kosong = mode terpandu)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_ENDPOINT=
LLM_TIMEOUT=30
TUTOR_BATAS_MENIT=300
